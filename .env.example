# ═══════════════════════════════════════════════
# SMTP — отправка отчётов и уведомлений helpdesk
# ═══════════════════════════════════════════════
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yandex.ru
SMTP_PASS=your_app_password

# Группы объектов и суффикс переменной с их адресатами: <Группа>:<СУФФИКС>
# через запятую. Имя группы должно совпадать с полем "group" в
# config/systems.json; адресаты берутся из REPORT_TO_<СУФФИКС>. Имена групп
# держим здесь, а не в коде — это данные заказчика.
REPORT_GROUPS=Группа A:GROUP_A,Группа B:GROUP_B

# Адресаты по группам (можно несколько через запятую)
REPORT_TO_GROUP_A=owner@yourdomain.com,manager@yourdomain.com
REPORT_TO_GROUP_B=other-owner@yourdomain.com

# Fallback-адрес: используется, если не задан group-specific (REPORT_TO_*)
REPORT_TO=admin@yourdomain.com

# Куда отправлять письма helpdesk (несколько через запятую).
# Это ЕДИНСТВЕННОЕ служебное письмо: в нём и неработающие камеры, и камеры,
# на которые стоит обратить внимание, и дефекты изображения.
HELPDESK_TO=helpdesk@yourdomain.com
# Через сколько дней напомнить о камере, которая всё ещё не работает.
# Объект, лежащий ЦЕЛИКОМ, напоминает о себе каждое утро и этот срок не ждёт.
HELPDESK_RENOTIFY_DAYS=3

# ═══════════════════════════════════════════════
# Объекты: креды и адреса
# ═══════════════════════════════════════════════
# Имена переменных здесь — сквозные SITE1..SITE7 из config/systems.example.json.
# В своём config/systems.json называйте их как удобно: конфиг ссылается на них
# полями *Env (логины/пароли) и плейсхолдерами ${VAR} (хосты и IP). Смысл в том,
# что в конфиге лежат только ИМЕНА переменных, а значения — здесь.

# Объект 1 — TRASSIR SDK HTTP API
SITE1_USER=Admin
SITE1_PASS=your_password

# Объект 2 — NVR по RTSP (iPanda и подобные)
SITE2_RTSP_USER=your_rtsp_user
SITE2_RTSP_PASS=your_rtsp_password
# Если поток забирается через NVR и там свои креды:
SITE2_NVR_RTSP_USER=admin
SITE2_NVR_RTSP_PASS=your_nvr_password

# Объект 3 — Hikvision/HiWatch ISAPI
SITE3_URL=
SITE3_USER=
SITE3_PASS=your_password

# Объект 4 — записи на SMB-шаре
SITE4_SMB_USER=your_smb_user
SITE4_SMB_PASS=your_smb_password

# Объект 5 — свежесть файлов на шаре
SITE5_SMB_USER=your_smb_user
SITE5_SMB_PASS=your_smb_password

# Объект 6 — одиночные ISAPI-камеры (у каждой свои креды)
SITE6_CAM1_USER=
SITE6_CAM1_PASS=your_password

# Объект 7 — личный кабинет оператора связи (Playwright)
PORTAL_URL=
PORTAL_USER=your_login
PORTAL_PASS=your_password

# ═══════════════════════════════════════════════
# Хосты и IP — все вынесены из config/systems.json
# (в JSON лежат плейсхолдеры{VAR}, реальные значения только здесь)
# ═══════════════════════════════════════════════
# Регистраторы, серверы и шары объектов
SITE1_HOST=198.51.100.1
SITE2_NVR_IP=198.51.100.2
SITE3_TAPO_HOST=198.51.100.3
SITE4_SMB_HOST=198.51.100.4
SITE5_SMB_HOST=198.51.100.5

# Одиночные камеры: у каждой свой host (сколько нужно, столько и заводите)
SITE6_CAM1_HOST=192.0.2.30
SITE6_CAM2_HOST=192.0.2.31

# Камеры в личном кабинете оператора: IP нужен для запасной ping-проверки
PORTAL_CAM1_IP=192.0.2.40
PORTAL_CAM2_IP=192.0.2.41

# uid камер в личном кабинете (config/systems.json ссылается на них
# плейсхолдерами ${..._UID}). По uid чекер сопоставляет камеры кабинета
# с конфигом: порядок выдачи API может поменяться, uid — нет.
# Где взять: node src/index.js --dry-run --only <id системы> --debug — в логе
# строка «Камеры API по порядку» содержит uid каждой камеры.
# Если переменную не задать, сопоставление откатится на порядок выдачи API.
PORTAL_CAM1_UID=00000000-0000-0000-0000-000000000001
PORTAL_CAM2_UID=00000000-0000-0000-0000-000000000002

# Подпись в email-отчётах. Все три — опциональные, можно не задавать.
# Если переменной нет — соответствующая строка просто не появится в письме.
REPORT_SIGN_NAME=
REPORT_SIGN_COMPANY=
REPORT_SIGN_PHONE=

# ═══════════════════════════════════════════════
# TP-Link Tapo (Wi-Fi камеры) — RTSP через Camera Account
# ═══════════════════════════════════════════════
# Camera Account = логин/пароль, создаваемые в мобильном приложении Tapo:
#   Settings → Advanced Settings → Camera Account
# Это отдельные креды от cloud-аккаунта (email TP-Link).
# Используются для RTSP-потока и snapshot.
TAPO_RTSP_USER=your_camera_account
TAPO_RTSP_PASS=your_camera_account_password

# Cloud-аккаунт TP-Link (email/пароль из приложения Tapo).
# Сейчас не используется: нужен будет, когда добавим прямую проверку
# microSD через KLAP API на :443. Оставлен в .env заранее.
TAPO_USER=your_email@example.com
TAPO_PASS=your_cloud_password

# ═══════════════════════════════════════════════
# Системные (v2)
# ═══════════════════════════════════════════════
# Путь к ffmpeg.exe — нужен для снимков iPanda RTSP и TP-Link Tapo.
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Сколько дней хранить YYYY-MM-DD папки в Bitrix24 Disk (старее — удаляются).
SNAPSHOT_RETENTION_DAYS=30

# ═══════════════════════════════════════════════
# Bitrix24 Disk (v2) — заливка снимков камер
# ═══════════════════════════════════════════════
# Inbound webhook вида https://your-portal.bitrix24.ru/rest/<id>/<token>/
BITRIX_WEBHOOK_URL=
# ID корневой папки Disk, куда складывать (структура AutoCamera/<группа>/<объект>/<YYYY-MM-DD>/).
# Узнать: node src/bitrix-disk.js init-folder
BITRIX_ROOT_FOLDER_ID=
BITRIX_STORAGE_ID=

# ═══════════════════════════════════════════════
# Тестовый режим (НЕ задавать на проде)
# ═══════════════════════════════════════════════
# При TEST_MODE=true письма уходят только на тестовые адреса (см. banner
# в логах при запуске), helpdesk отключается при пустом HELPDESK_TO.
# TEST_MODE=true

# ═════════════════════════════════════════════════
# v3: веб-интерфейс и карта состояния объектов
# ═════════════════════════════════════════════════
# Веб-сервер (server/app.js, запуск: npm run web). 127.0.0.1 — доступ только
# с самой машины; чтобы открыть из локальной сети предприятия, поставить 0.0.0.0.
WEB_HOST=127.0.0.1
# 8080 на этой машине занят веб-картой Wi-Fi (проект wifi-monitor).
WEB_PORT=8081
# Какую группу объектов показывать на карте (имя группы — как в systems.json).
# Пусто — все группы. Удалённые площадки на карту обычно не выносят.
WEB_GROUP=
WEB_SITE_NAME=Мониторинг видеонаблюдения
WEB_SESSION_TTL_HOURS=12
# true — только когда сервер стоит за HTTPS (иначе cookie не долетит).
WEB_SECURE_COOKIE=false
# Через сколько секунд молчания мониторинга данные считаются устаревшими
# (light-прогон ходит раз в 15 минут, поэтому 40 минут = мониторинг встал).
WEB_STALE_AFTER_SEC=2400

# Карта — Yandex Maps JS API. Ключ виден в браузере (норма для JS API),
# обязательно ограничить его по домену-referer в кабинете Яндекса. Без ключа
# карта не загрузится, но список камер справа продолжит работать.
YANDEX_API_KEY=your_yandex_maps_js_api_key
# Центр/зум карты по умолчанию (пока у камер нет координат). Впишите координаты
# своей площадки — это данные объекта, поэтому в .env, а не в коде/репозитории.
MAP_CENTER_LAT=55.751000
MAP_CENTER_LON=37.618000
MAP_ZOOM=18
# Подложка: yandex#hybrid (спутник + подписи) удобна для расстановки камер;
# yandex#map (схема) — если спутник/гибрид недоступен по тарифу ключа.
# ВАЖНО: значение в кавычках — иначе dotenv обрежет всё после «#» как комментарий.
MAP_TYPE="yandex#hybrid"
# Камеры каких объектов показывать на карте — id систем из config/systems.json
# через запятую. Порядок задаёт и порядок групп в списке справа. Координаты
# объектов берутся из geo.txt (после правки — npm run build-points); объект без
# координат в geo.txt на карту не выводите: его камеры лягут у общего центра.
# Старое имя WEB_MAP_SYSTEM (ровно один объект) ещё понимается — для старых .env.
# Не выводите на карту два объекта, которые описывают ОДНИ И ТЕ ЖЕ камеры:
# получите на карте дубли точек в одном месте.
WEB_MAP_SYSTEMS=site-1,site-2,site-3

# Камеры второго этажа — список cam_key через запятую (`<id объекта>|<имя камеры>`).
# Всё, чего здесь нет, считается первым этажом.
# По этому списку карта показывает выпадающий список этажей — только у тех
# объектов, чьи камеры здесь перечислены. Пусто — кнопок этажей нет нигде.
WEB_FLOOR2_CAMERAS=

# Камеры, которые не показывать на карте, — список cam_key через запятую.
# Нужен для заглушек, застрявших в monitor.db: если ISAPI-опрос объекта падает
# целиком, прогон записывает безымянную камеру, БД даёт ей имя вида «Камера 1»,
# и она навсегда висит на карте как «нет данных».
WEB_HIDE_CAMERAS=


# --- v3 пункт 1: статистика неисправностей ---
# «Требуют внимания»: камера сейчас работает, но за период пропадала и
# возвращалась сама. Пороги подобраны на реальной истории — мягче делать
# нельзя, блок превращается в шум и его перестают читать.
ATTENTION_DAYS=7
ATTENTION_MIN_DOWNTIME_MIN=180
ATTENTION_MIN_FALLS=10
ATTENTION_LIMIT=15
# Сбой объекта целиком вместо перечисления всех его камер в заявке:
# сломано не меньше OUTAGE_RATIO от проверенных и не меньше OUTAGE_MIN_CAMERAS штук.
OUTAGE_RATIO=0.8
OUTAGE_MIN_CAMERAS=3

# Как часто напоминать об одной и той же нестабильной камере. Без этого
# один и тот же абзац повторялся бы в письме каждое утро: камера держится
# в статистике неделями.
ATTENTION_RENOTIFY_DAYS=14
# Через сколько дней отсутствия в списке камера забывается (потом — как новая).
ATTENTION_FORGET_DAYS=7


# --- v3 пункт 2: контроль качества изображения ---
# Пороги подобраны замером по 88 рабочим кадрам объектов (яркость 44-184,
# резкость 319-5664) и проверкой на намеренно испорченных кадрах.
QUALITY_DARK_MEAN=25
QUALITY_DARK_RATIO=0.9
QUALITY_BRIGHT_MEAN=230
QUALITY_BRIGHT_RATIO=0.6
QUALITY_BLUR_ABS=100
QUALITY_BLUR_REL=0.4
QUALITY_NOISE_REL=2
# Смена ракурса: кадр должен разойтись со ВСЕМИ эталонами ниже этой
# корреляции. Порог ужесточён 18.08.2026 — при 0.5 в заявки попадал сдвиг
# на пару градусов и обычная смена освещения.
QUALITY_ANGLE_CORR=0.3
# Сколько свежих прогонов пропустить, прежде чем брать эталоны: иначе
# разворот камеры «станет нормой» за один прогон и мы его не заметим.
QUALITY_ANGLE_BASE_RUNS=3
# Сколько кадров подряд взять в эталоны. Окно покрывает разные законные
# состояния сцены (день/ночь, свет включён/выключен); совпадение хотя бы
# с одним = камера смотрит туда же.
QUALITY_ANGLE_WINDOW=10
# Сколько прогонов подряд дефект должен держаться до заявки (защита от
# ложных срабатываний — прямое требование ТЗ).
QUALITY_MIN_STREAK=3
QUALITY_RENOTIFY_DAYS=14
# Сколько дней хранить метрики кадров в monitor.db.
QUALITY_HISTORY_DAYS=90


# --- Тестовая среда ---
# Печатает в лог баннер с реальными адресами получателей — защита от запуска
# прод-конфига в тестовой папке. На боевой машине НЕ задавать.
# TEST_MODE=true
