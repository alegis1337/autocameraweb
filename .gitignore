node_modules/
.env
.env.bak
*.bak
*.tmp

# Runtime data
screenshots/
!screenshots/.gitkeep
reports/*.html
logs/*.log

# v2: state (helpdesk-state + дневные timeline-*.json — динамика, не в git)
state/
!state/.gitkeep

# Автогенерируемый лаунчер скрытого запуска (setup-schedule.ps1) —
# зашивает локальные абсолютные пути node.exe/проекта, в git не заливаем.
run-hidden.vbs

# Состав объектов и камер — данные заказчика. В репозиторий идёт только
# образец config/systems.example.json со сквозными site-1..site-7.
config/systems.json

# v3: координаты объектов заказчика и собранный из них файл карты.
# geo.txt.example с образцом формата — в репо.
geo.txt
public/points.json

# Текстовый README для оператора на ВМ — тоже только локально: он намеренно
# конкретный (какие объекты на карте, сколько камер, что где лежит), а это
# состав объектов заказчика. Публичная документация — README.md.
docs/README.txt

# Инструкция для сотрудников — на гит не заливаем: внутри реальный адрес
# SMB-шары, почта заказчика и helpdesk, ФИО и телефон инженера сопровождения.
# По `.claude rules/03-secrets.md` всё это секреты. Файл остаётся на диске
# в docs/ и раздаётся сотрудникам как раньше.
docs/autocamera-manual.docx

# OS
Thumbs.db
Desktop.ini
.DS_Store
nul

# IDE
.vscode/
.idea/

# Claude Code local settings
.claude/

# Локальные рабочие правила агента (Claude). Лежат только локально,
# в репо не заливаем (могут содержать упоминания путей с именем
# пользователя ВМ, рабочие договорённости и т.п.).
.claude rules/

# Внутренние рабочие документы — только локально, на гит не публикуем
# (решение 13.08.2026, по той же причине, что и `.claude rules/`: там пути
# с именем пользователя ВМ, порты, имена задач Планировщика, рабочие
# договорённости и внутренняя кухня проекта).
# CLAUDE.md — инструкции агенту, CHANGELOG.md — датированная история правок.
# Оба остаются на диске и продолжают вестись как раньше.
CLAUDE.md
CHANGELOG.md
